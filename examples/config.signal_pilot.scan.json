{
  "vars": {
    "as_of": "2026-03-16"
  },
  "command": "scan-alerts",
  "symbols": ["QQQ", "ETH"],
  "strategy": "score_regime",
  "params": {
    "momentum_window": 63,
    "trend_window": 120,
    "mean_revert_window": 20,
    "volatility_window": 30,
    "score_threshold": 0.15,
    "weights": [0.5, 0.3, 0.2]
  },
  "interval": "1d",
  "lookback_days": 365,
  "end": "${as_of}",
  "account_id": "default",
  "ledger_file": "signal_alert_ledger.csv",
  "notification_file": "signal_pilot_notifications.jsonl"
}
