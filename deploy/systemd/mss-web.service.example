[Unit]
Description=Market Signal System Web
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/market-signal-system
Environment="PYTHONPATH=src"
Environment="MSS_DB_PATH=data/state/market_signal_system.db"
Environment="MSS_HOST=127.0.0.1"
Environment="MSS_PORT=8080"
ExecStart=/usr/bin/python3 scripts/run_web.py --host ${MSS_HOST} --port ${MSS_PORT} --db-path ${MSS_DB_PATH}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
